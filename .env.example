# Public TLS origin for the MCP endpoint and OAuth issuer. The resource URI becomes
# https://mcp.example.com/mcp. Keep this at the origin, with no path.
MCP_PUBLIC_URL=https://mcp.example.com

# Bind locally behind a TLS reverse proxy or secure tunnel.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Include the public host if the reverse proxy forwards a different Host header.
MCP_ALLOWED_HOSTS=mcp.example.com,127.0.0.1:3000,localhost:3000
# Additional browser origins only when needed; the MCP issuer origin is always allowed.
MCP_ALLOWED_ORIGINS=

# PostgreSQL login for the fenix_mcp_runtime role. Run npm run migrate:oauth first
# with OAUTH_ADMIN_DATABASE_URL set in the shell.
# OAUTH_ADMIN_DATABASE_URL=postgresql://admin:CHANGE_ME@127.0.0.1:5432/fenix_mcp
# FENIX_MCP_RUNTIME_PASSWORD=CHANGE_ME
# FENIX_MCP_MIGRATOR_PASSWORD=CHANGE_ME
# FENIX_MCP_REVOKER_PASSWORD=CHANGE_ME
# FENIX_MCP_METADATA_RESTORE_PASSWORD=CHANGE_ME
OAUTH_DATABASE_URL=postgresql://fenix_mcp_runtime:CHANGE_ME@127.0.0.1:5432/fenix_mcp?sslmode=disable
OAUTH_HMAC_KEYRING_JSON='{"active":"v1","keys":{"v1":"BASE64_32_BYTE_KEY"}}'
OAUTH_ENCRYPTION_KEYRING_JSON='{"active":"v1","keys":{"v1":"BASE64_32_BYTE_KEY"}}'

# Official Fênix API host. FENIX_HCAPTCHA_SITEKEY is public, not a secret.
FENIX_BASE_URL=https://fenix.cbm.ba.gov.br
# Set FENIX_BASE_URL to MCP_PUBLIC_URL and provide this secret only when the Cloudflare upstream proxy is deployed.
# FENIX_PROXY_TOKEN=GENERATE_A_RANDOM_SECRET_AND_SET_AS_A_WORKER_SECRET_TOO
FENIX_FRONTEND_VERSION=2.19.1
FENIX_HCAPTCHA_SITEKEY=e94868de-18ba-4314-b0ce-c7c84a1440b6
FENIX_TIMEOUT_MS=30000
FENIX_RATE_LIMIT_PER_MINUTE=60
FENIX_GET_RETRIES=1
